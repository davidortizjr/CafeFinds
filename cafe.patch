diff --git a/server/lib/auth.js b/server/lib/auth.js
new file mode 100644
index 0000000..09b6cd0
--- /dev/null
+++ b/server/lib/auth.js
@@ -0,0 +1,102 @@
+import bcrypt from 'bcryptjs'
+import jwt from 'jsonwebtoken'
+import { prisma } from './prisma.js'
+
+// Sessions are a signed JWT in an httpOnly cookie. The cookie is SameSite=Lax
+// and every write endpoint expects a JSON body, so other sites cannot forge
+// requests with it. `tv` (tokenVersion) lets us invalidate every session at
+// once by bumping the number on the user row, which is what a password
+// change or reset does.
+
+const COOKIE_NAME = 'cf_session'
+const MAX_AGE_SECONDS = 60 * 60 * 24 * 30 // 30 days
+const isProd = process.env.NODE_ENV === 'production'
+
+function jwtSecret() {
+  const secret = process.env.JWT_SECRET
+  if (secret) return secret
+  if (isProd) throw new Error('JWT_SECRET must be set in production')
+  return 'dev-only-insecure-secret' // local development only
+}
+
+// ---- passwords -------------------------------------------------------------
+
+const BCRYPT_ROUNDS = 10
+// Compared against when no account matches, so a miss takes as long as a hit.
+const DUMMY_HASH = bcrypt.hashSync('not-a-real-password', BCRYPT_ROUNDS)
+
+export const hashPassword = (password) => bcrypt.hash(password, BCRYPT_ROUNDS)
+
+export async function checkPassword(password, hash) {
+  return bcrypt.compare(typeof password === 'string' ? password : '', hash || DUMMY_HASH).then((ok) => ok && Boolean(hash))
+}
+
+// ---- cookies ---------------------------------------------------------------
+
+function parseCookies(header = '') {
+  const out = {}
+  for (const part of header.split(';')) {
+    const i = part.indexOf('=')
+    if (i < 0) continue
+    try {
+      out[part.slice(0, i).trim()] = decodeURIComponent(part.slice(i + 1).trim())
+    } catch {
+      // ignore malformed cookie values
+    }
+  }
+  return out
+}
+
+function cookieString(value, maxAge) {
+  const attrs = [`${COOKIE_NAME}=${value}`, 'Path=/', 'HttpOnly', 'SameSite=Lax', `Max-Age=${maxAge}`]
+  if (isProd) attrs.push('Secure')
+  return attrs.join('; ')
+}
+
+export function startSession(res, user) {
+  const token = jwt.sign({ sub: user.id, tv: user.tokenVersion }, jwtSecret(), { expiresIn: MAX_AGE_SECONDS })
+  res.setHeader('Set-Cookie', cookieString(token, MAX_AGE_SECONDS))
+}
+
+export function endSession(res) {
+  res.setHeader('Set-Cookie', cookieString('', 0))
+}
+
+// ---- middleware ------------------------------------------------------------
+
+// Sets req.user to the signed-in user, or null for guests. Never rejects, so
+// public routes (browsing cafes) can use it too.
+export async function attachUser(req, res, next) {
+  req.user = null
+  try {
+    const token = parseCookies(req.headers.cookie)[COOKIE_NAME]
+    if (token) {
+      const payload = jwt.verify(token, jwtSecret())
+      const user = await prisma.user.findUnique({ where: { id: payload.sub } })
+      if (user && user.tokenVersion === payload.tv) req.user = user
+    }
+  } catch (err) {
+    // An expired or tampered token just means "guest". Anything else is a real error.
+    if (!(err instanceof jwt.JsonWebTokenError || err instanceof jwt.TokenExpiredError)) return next(err)
+  }
+  next()
+}
+
+export function requireAuth(req, res, next) {
+  if (!req.user) return res.status(401).json({ error: 'Sign in to do that.', code: 'auth_required' })
+  next()
+}
+
+// ---- serializers -----------------------------------------------------------
+
+// What the signed-in person sees about themselves.
+export function privateUser(user) {
+  return {
+    id: user.id,
+    email: user.email,
+    username: user.username,
+    name: user.name,
+    bio: user.bio,
+    createdAt: user.createdAt
+  }
+}
diff --git a/server/lib/mail.js b/server/lib/mail.js
new file mode 100644
index 0000000..4986058
--- /dev/null
+++ b/server/lib/mail.js
@@ -0,0 +1,46 @@
+// Password-reset email. Uses Resend's REST API when RESEND_API_KEY is set.
+// Without a key, local development prints the link to the server console so
+// the flow can still be tested; production never logs the link.
+
+const isProd = process.env.NODE_ENV === 'production'
+
+export function appUrl() {
+  if (process.env.APP_URL) return process.env.APP_URL.replace(/\/$/, '')
+  // Vercel exposes the production domain (no protocol) as a system variable.
+  if (process.env.VERCEL_PROJECT_PRODUCTION_URL) return `https://${process.env.VERCEL_PROJECT_PRODUCTION_URL}`
+  return 'http://localhost:5173'
+}
+
+export async function sendPasswordResetEmail(to, link) {
+  const key = process.env.RESEND_API_KEY
+
+  if (!key) {
+    if (isProd) {
+      console.error('[mail] RESEND_API_KEY is not set, so the password reset email was not sent.')
+    } else {
+      console.log(`[mail] Password reset link for ${to}:\n${link}`)
+    }
+    return
+  }
+
+  const from = process.env.EMAIL_FROM || 'CaféFinds <onboarding@resend.dev>'
+  const text = `Someone asked to reset the password for your CaféFinds account.\n\nChoose a new password (the link works for one hour):\n${link}\n\nIf this wasn't you, you can ignore this email and your password stays the same.`
+  const html = `<div style="font-family:system-ui,sans-serif;max-width:420px;margin:0 auto;padding:24px;color:#1c1410">
+  <h1 style="font-size:22px;margin:0 0 12px">Reset your password</h1>
+  <p style="line-height:1.5;margin:0 0 20px">Someone asked to reset the password for your CaféFinds account. The link works for one hour.</p>
+  <p style="margin:0 0 20px"><a href="${link}" style="display:inline-block;background:#d2303f;color:#fff;text-decoration:none;padding:12px 20px;border-radius:999px;font-weight:600">Choose a new password</a></p>
+  <p style="line-height:1.5;color:#5e655f;font-size:13px;margin:0">If this wasn't you, ignore this email and your password stays the same.</p>
+</div>`
+
+  try {
+    const res = await fetch('https://api.resend.com/emails', {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify({ from, to, subject: 'Reset your CaféFinds password', html, text })
+    })
+    if (!res.ok) console.error('[mail] Resend rejected the email:', res.status, await res.text())
+  } catch (err) {
+    // Swallow: the caller always answers the same way so we never reveal which emails have accounts.
+    console.error('[mail] Could not reach Resend:', err.message)
+  }
+}
diff --git a/server/lib/validate.js b/server/lib/validate.js
new file mode 100644
index 0000000..596676e
--- /dev/null
+++ b/server/lib/validate.js
@@ -0,0 +1,44 @@
+// Small input validators shared by the auth, settings and review routes.
+// Each returns { value } on success or { error } with a message that is safe
+// to show to the person filling in the form.
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
+const USERNAME_RE = /^[a-z0-9_]{3,20}$/
+
+export function parseEmail(raw) {
+  const value = typeof raw === 'string' ? raw.trim().toLowerCase() : ''
+  if (!value) return { error: 'Enter your email address.' }
+  if (value.length > 254 || !EMAIL_RE.test(value)) return { error: 'Enter a valid email address.' }
+  return { value }
+}
+
+export function parseUsername(raw) {
+  const value = typeof raw === 'string' ? raw.trim().toLowerCase().replace(/^@/, '') : ''
+  if (!value) return { error: 'Choose a username.' }
+  if (!USERNAME_RE.test(value)) {
+    return { error: 'Usernames are 3–20 characters: letters, numbers and underscores.' }
+  }
+  return { value }
+}
+
+// bcrypt only reads the first 72 bytes, so reject anything longer instead of
+// silently truncating it.
+export function parsePassword(raw) {
+  if (typeof raw !== 'string' || raw.length < 8) {
+    return { error: 'Use at least 8 characters for your password.' }
+  }
+  if (Buffer.byteLength(raw, 'utf8') > 72) {
+    return { error: 'That password is too long. Keep it under 72 bytes.' }
+  }
+  return { value: raw }
+}
+
+export function parseDisplayName(raw, fallback = '') {
+  const value = typeof raw === 'string' ? raw.trim().replace(/\s+/g, ' ').slice(0, 40) : ''
+  return { value: value || fallback }
+}
+
+export function parseBio(raw) {
+  const value = typeof raw === 'string' ? raw.trim().slice(0, 160) : ''
+  return { value: value || null }
+}
diff --git a/server/routes/auth.js b/server/routes/auth.js
new file mode 100644
index 0000000..3682a70
--- /dev/null
+++ b/server/routes/auth.js
@@ -0,0 +1,164 @@
+import crypto from 'node:crypto'
+import { Router } from 'express'
+import rateLimit from 'express-rate-limit'
+import { prisma } from '../lib/prisma.js'
+import { checkPassword, endSession, hashPassword, privateUser, startSession } from '../lib/auth.js'
+import { appUrl, sendPasswordResetEmail } from '../lib/mail.js'
+import { parseDisplayName, parseEmail, parsePassword, parseUsername } from '../lib/validate.js'
+
+const router = Router()
+
+// Best-effort brute-force protection. On serverless each instance keeps its
+// own counter, so treat this as a speed bump and put a shared store (or the
+// host's firewall) behind it if the app gets real traffic.
+const limiter = rateLimit({
+  windowMs: 15 * 60 * 1000,
+  limit: 20,
+  standardHeaders: 'draft-7',
+  legacyHeaders: false,
+  message: { error: 'Too many attempts. Wait a few minutes and try again.' }
+})
+
+const fail = (res, status, error, field) => res.status(status).json({ error, ...(field ? { field } : {}) })
+
+const sha256 = (value) => crypto.createHash('sha256').update(value).digest('hex')
+
+router.get('/me', (req, res) => {
+  res.json({ user: req.user ? privateUser(req.user) : null })
+})
+
+router.post('/register', limiter, async (req, res, next) => {
+  try {
+    const body = req.body ?? {}
+    const email = parseEmail(body.email)
+    if (email.error) return fail(res, 400, email.error, 'email')
+    const username = parseUsername(body.username)
+    if (username.error) return fail(res, 400, username.error, 'username')
+    const password = parsePassword(body.password)
+    if (password.error) return fail(res, 400, password.error, 'password')
+    const name = parseDisplayName(body.name, username.value)
+
+    const taken = await prisma.user.findFirst({
+      where: { OR: [{ email: email.value }, { username: username.value }] }
+    })
+    if (taken) {
+      return taken.email === email.value
+        ? fail(res, 409, 'An account with this email already exists. Try signing in.', 'email')
+        : fail(res, 409, 'That username is taken. Try another.', 'username')
+    }
+
+    const passwordHash = await hashPassword(password.value)
+    const data = { email: email.value, username: username.value, name: name.value, passwordHash }
+
+    // Someone who used the app before accounts existed still has a device id.
+    // If that anonymous profile is unclaimed, turn it into this account so
+    // their visited list and reviews carry over.
+    let legacy = null
+    if (typeof body.deviceId === 'string' && body.deviceId) {
+      const found = await prisma.user.findUnique({ where: { deviceId: body.deviceId } })
+      if (found && !found.passwordHash) legacy = found
+    }
+
+    const user = legacy
+      ? await prisma.user.update({ where: { id: legacy.id }, data: { ...data, deviceId: null } })
+      : await prisma.user.create({ data })
+
+    startSession(res, user)
+    res.status(201).json({ user: privateUser(user), claimedLegacy: Boolean(legacy) })
+  } catch (err) {
+    // Two people registering the same email or username at once.
+    if (err?.code === 'P2002') return fail(res, 409, 'That email or username is already taken.')
+    next(err)
+  }
+})
+
+router.post('/login', limiter, async (req, res, next) => {
+  try {
+    const identifier = typeof req.body?.identifier === 'string' ? req.body.identifier.trim().toLowerCase().replace(/^@/, '') : ''
+    const password = req.body?.password
+    if (!identifier || typeof password !== 'string' || !password) {
+      return fail(res, 400, 'Enter your email or username and your password.')
+    }
+
+    const user = await prisma.user.findUnique({
+      where: identifier.includes('@') ? { email: identifier } : { username: identifier }
+    })
+
+    if (!(await checkPassword(password, user?.passwordHash))) {
+      return fail(res, 401, 'That email, username or password is not right.')
+    }
+
+    startSession(res, user)
+    res.json({ user: privateUser(user) })
+  } catch (err) {
+    next(err)
+  }
+})
+
+router.post('/logout', (req, res) => {
+  endSession(res)
+  res.status(204).end()
+})
+
+// Always answers the same way, whether or not the email has an account, so
+// the form can't be used to find out who is registered.
+router.post('/forgot', limiter, async (req, res, next) => {
+  try {
+    const email = parseEmail(req.body?.email)
+    if (email.error) return fail(res, 400, email.error, 'email')
+
+    const user = await prisma.user.findUnique({ where: { email: email.value } })
+    if (user?.passwordHash) {
+      const token = crypto.randomBytes(32).toString('base64url')
+      await prisma.passwordReset.deleteMany({ where: { userId: user.id } })
+      await prisma.passwordReset.create({
+        data: {
+          userId: user.id,
+          tokenHash: sha256(token),
+          expiresAt: new Date(Date.now() + 60 * 60 * 1000) // 1 hour
+        }
+      })
+      await sendPasswordResetEmail(user.email, `${appUrl()}/reset-password?token=${token}`)
+    }
+
+    res.json({ ok: true })
+  } catch (err) {
+    next(err)
+  }
+})
+
+router.post('/reset', limiter, async (req, res, next) => {
+  try {
+    const token = typeof req.body?.token === 'string' ? req.body.token : ''
+    const password = parsePassword(req.body?.password)
+    if (password.error) return fail(res, 400, password.error, 'password')
