// Prisma schema for Caféfinds — a coffee-shop log
// Datasource is Neon (serverless Postgres). See README for setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  // Legacy anonymous id from before accounts existed. New users never get one;
  // it is only kept so an old device can claim its log when it registers.
  deviceId     String?  @unique
  // email/username/passwordHash are null only for those legacy anonymous rows.
  email        String?  @unique // stored lowercased
  username     String?  @unique // stored lowercased, 3-20 chars [a-z0-9_]
  passwordHash String?
  name         String   @default("You") // display name
  bio          String?
  // Bumped on password change/reset so every existing session cookie stops working.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  reviews        Review[]
  visits         Visit[]
  passwordResets PasswordReset[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 of the emailed token; the raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model Cafe {
  id        String   @id @default(cuid())
  placeId   String   @unique // Google Places place_id
  name      String
  address   String?
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  reviews Review[]
  visits  Visit[]

  @@index([lat, lng])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  text      String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  cafe   Cafe   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  cafeId String

  @@unique([userId, cafeId]) // one review per user per cafe, editable
  @@index([cafeId])
}

model Visit {
  id        String   @id @default(cuid())
  visitedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  cafe   Cafe   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  cafeId String

  @@unique([userId, cafeId]) // the "checklist" toggle — present = visited
  @@index([cafeId])
}
