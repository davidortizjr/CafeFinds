# Neon Postgres — copy both from your Neon project's "Connect" panel.
# DATABASE_URL: pooled connection (uses pgbouncer), used at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/cupboard?sslmode=require"
# DIRECT_URL: unpooled connection, used only for migrations.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/cupboard?sslmode=require"

# Google Maps JS API key. Restrict it to your domain(s) in Google Cloud
# Console (HTTP referrers). Must have the "Maps JavaScript API" and
# "Places API" enabled. VITE_ prefix exposes it to the client — that is
# expected for the Maps JS API, security comes from the referrer restriction.
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Signs the session cookie. REQUIRED in production (the API refuses to start
# sessions without it). Generate one with: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET="replace-with-a-long-random-string"

# Public address of the app, used to build the link in password-reset emails.
# On Vercel this falls back to the production domain automatically.
APP_URL="http://localhost:5173"

# Password-reset email, sent through Resend (https://resend.com).
# Without RESEND_API_KEY, local development prints the reset link to the
# server console instead, and production sends nothing.
RESEND_API_KEY=""
# Must be an address on a domain you've verified in Resend.
EMAIL_FROM="CaféFinds <hello@yourdomain.com>"
